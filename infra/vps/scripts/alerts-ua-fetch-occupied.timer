[Unit]
Description=Daily Fetch of Occupied Territories Data

[Timer]
# Запуск каждый день в 05:00 по Киевскому времени (EEST = UTC+3)
# 05:00 EEST = 02:00 UTC
OnCalendar=02:00 UTC
Persistent=true
# Явная ссылка на сервис: Requires= в [Unit] таймера запускал бы его
# немедленно при enable --now (внеплановый fetch + рестарт API после деплоя)
Unit=alerts-ua-fetch-occupied.service

# Если компьютер был выключен, запустить при загрузке если прошло время
# (аналог anacron)

[Install]
WantedBy=timers.target
