[Unit]
Description=Alerts UA XLSX import
After=network.target

[Service]
Type=oneshot
User=alerts-ua
Group=alerts-ua
WorkingDirectory=/srv/alerts-ua/app/current
EnvironmentFile=/srv/alerts-ua/env/.env.worker
ExecStart=/srv/alerts-ua/runtime/node/bin/node dist/workers/import.js
# Зависший oneshot (XLSX по сети) не должен блокировать таймер бесконечно
TimeoutStartSec=300
