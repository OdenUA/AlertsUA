DATABASE_URL=postgresql://INSERT_DB_USER:INSERT_DB_PASSWORD@127.0.0.1:5432/alerts_ua
NODE_ENV=development
FIREBASE_PROJECT_ID=alert-ua-app
FIREBASE_PRIVATE_KEY="INSERT_FIREBASE_PRIVATE_KEY"
FIREBASE_CLIENT_EMAIL="INSERT_FIREBASE_CLIENT_EMAIL"

# Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=
CACHE_ENABLED=true

# Push delivery
PUSH_WORKER_CONCURRENCY=2
PUSH_BATCH_SIZE=500
PUSH_IDLE_POLL_MS=1000
PUSH_CLAIM_LEASE_MS=120000
PUSH_FCM_MAX_RPS=1000
PUSH_FCM_RAMP_MS=60000
PUSH_START_TTL_SECONDS=600
PUSH_END_TTL_SECONDS=300
PUSH_LEVEL_CHANGED_TTL_SECONDS=180
PUSH_TOKEN_SUCCESS_UPDATE_INTERVAL_SECONDS=3600
